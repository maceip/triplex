<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="dev.triplex.debug.DevelopmentControlReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.triplex.debug.PROVISION" />
                <action android:name="dev.triplex.debug.OUTBOUND_SMOKE" />
                <action android:name="dev.triplex.debug.VOICE_CLONE_SMOKE" />
                <action android:name="dev.triplex.debug.FETCH_QWEN3_MODELS" />
                <action android:name="dev.triplex.debug.OPEN_VOICE" />
                <action android:name="dev.triplex.debug.SET_CLONED_POLICY" />
                <action android:name="dev.triplex.debug.HANGUP" />
            </intent-filter>
        </receiver>
        <service
            android:name="dev.triplex.debug.DevelopmentControlService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs ADB-triggered Triplex development enroll and call checks." />
        </service>
        <receiver
            android:name="dev.triplex.debug.DebugSipProvisioningReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.triplex.debug.PROVISION_SIP" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
