{
  "name": "Triplex",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "gateway",
      "command": "cd gateway && . .venv/bin/activate && DATABASE_URL='postgresql+asyncpg://triplex:triplex@127.0.0.1:5432/triplex' ADMIN_API_KEY='dev-admin-key' uvicorn app.api.main:app --host 0.0.0.0 --port 8000 --reload"
    }
  ],
  "ports": [8000]
}
