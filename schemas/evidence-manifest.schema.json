{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvidenceManifest",
  "type": "object",
  "required": ["version", "created", "git", "evidence", "gates", "summary"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "git": {
      "type": "object",
      "required": ["commit", "branch"],
      "properties": {
        "commit": { "type": "string" },
        "branch": { "type": "string" },
        "author": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "ci": {
      "type": "object",
      "properties": {
        "commit": { "type": "string" },
        "pr": { "type": "string" },
        "run_id": { "type": "string" },
        "workflow": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["hash", "size", "modified"],
        "properties": {
          "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": { "type": "integer", "minimum": 0 },
          "modified": { "type": "string", "format": "date-time" }
        }
      }
    },
    "gates": {
      "type": "object",
      "required": ["rt_allocation_guard", "transport_validation", "gateway_integration", "android_build"],
      "properties": {
        "rt_allocation_guard": { "type": "string", "enum": ["passed", "failed", "pending"] },
        "transport_validation": { "type": "string", "enum": ["passed", "failed", "pending"] },
        "gateway_integration": { "type": "string", "enum": ["passed", "failed", "pending"] },
        "android_build": { "type": "string", "enum": ["passed", "failed", "pending"] }
      }
    },
    "summary": {
      "type": "object",
      "required": ["total_files", "total_size_bytes"],
      "properties": {
        "total_files": { "type": "integer", "minimum": 0 },
        "total_size_bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
